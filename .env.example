# Copy to .env (untracked) and fill in this machine's folders.

# the reference data: star catalogue, ephemeris, element files, map layers
SKYFIND_DATA_DIR=/path/to/skyfind-data
# where the clips are: /clips inside the container (work folders go next
# to each clip)
CLIPS_DIR=/path/to/clips
# scratch work folders: /work inside (default: ./work, untracked)
# WORK_DIR=/path/to/scratch
# the image engine's checkout, with docker-compose.engine.yml (default:
# beside this repo; without that file, the commit uv.lock pins)
# REMOVE_SATELLITES_DIR=../remove-satellites
# shared memory for the orbit table (a whole night's catalogue: ~4 GB)
# SHM_SIZE=16gb
# with an NVIDIA GPU (on Windows separate the files with ;); add
# docker-compose.engine.yml to build a local checkout of the engine
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
